# Clave de API de Google AI Studio (obligatoria en producción)
GEMINI_API_KEY=tu_clave_de_google_ai_studio_aqui

# Modelo de Gemini compatible con documentos PDF y salida estructurada JSON
# Recomendado: gemini-3.8-flash (rápido y económico) o gemini-pro-latest (mayor profundidad)
GEMINI_MODEL=gemini-3.8-flash

# Límites configurables de uso en servidor (opcional)
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_MS=60000
